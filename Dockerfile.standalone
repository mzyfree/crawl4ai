# 26.1.310 - Janitor hardening and monitor visibility (layered on standalone-v2)
# Base: 26.1.214-release standalone-v2
# Changes: crawler_pool.py janitor hardening + monitor.py janitor heartbeat/debug
#
# Build:
#   docker buildx build --platform linux/amd64 -f Dockerfile.standalone \
#     -t docker-registry.int.rclabenv.com:443/ai/c4ai:26.1.310-release.$(git rev-parse --short HEAD).$(date +%Y%m%d)-standalone \
#     --push .
#
FROM docker-registry.int.rclabenv.com:443/ai/c4ai:26.1.214-release.51bbccd.20260310-standalone-v2

WORKDIR /app

# Overlay our modified crawler_pool
COPY deploy/docker/crawler_pool.py /app/crawler_pool.py
COPY deploy/docker/monitor.py /app/monitor.py
COPY deploy/docker/monitor_routes.py /app/monitor_routes.py
COPY crawl4ai/browser_manager.py /tmp/browser_manager.py

USER root
RUN python3 -m pip install --no-cache-dir --upgrade "pillow==13.0.0" && \
    python3 -m pip check && \
    python3 -c "from PIL import Image; import PIL; assert PIL.__version__ == '13.0.0'; print('Pillow', PIL.__version__)" && \
    python3 -c "import crawl4ai, pathlib, shutil; base = pathlib.Path(crawl4ai.__file__).parent; shutil.copy('/tmp/browser_manager.py', base / 'browser_manager.py'); print(f'patched: {base / \"browser_manager.py\"}')" && \
    chown appuser:appuser /app/crawler_pool.py /app/monitor.py /app/monitor_routes.py
USER appuser

EXPOSE 11235 6379
